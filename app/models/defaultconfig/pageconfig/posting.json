{
  "textControl": {
    "minPostLength": 5,
    "maxPostLength": 50000,
    "minTitleLength": 5,
    "maxTitleLength": 100
  },
  "uploadControl": {
    "allowAttachments": true,
    "authorizedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp"
    ],
    "maxAttachmentSizeKb": 5120
  },
  "attachments": {
    "enabled": true,
    "minTrustLevel": 100,
    "maxFileSizeKb": 5120,
    "maxFilesPerPost": 5,
    "extensions": [
      ".pdf",
      ".txt",
      ".zip"
    ]
  }
}
