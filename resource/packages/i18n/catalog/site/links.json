  "principles.healthy": {
    "source": "内容健康、长期可访问。",
    "translations": {
      "en": {"text":"Healthy content and long-term availability.","sourceRevision":"9c9fdb147c8a5acdd196ea43e3cc676fdaf673b276c66c8467fc5398c0c6137b","reviewed":true},
      "ja": {"text":"健全なコンテンツで長期間アクセスできること。","sourceRevision":"9c9fdb147c8a5acdd196ea43e3cc676fdaf673b276c66c8467fc5398c0c6137b","reviewed":true},
      "it": {"text":"Contenuti sicuri e disponibilità a lungo termine.","sourceRevision":"9c9fdb147c8a5acdd196ea43e3cc676fdaf673b276c66c8467fc5398c0c6137b","reviewed":true},
      "ru": {"text":"Полезный контент и долгосрочная доступность сайта.","sourceRevision":"9c9fdb147c8a5acdd196ea43e3cc676fdaf673b276c66c8467fc5398c0c6137b","reviewed":true},
      "ko": {"text":"건강한 내용 및 장기 가용성.","sourceRevision":"9c9fdb147c8a5acdd196ea43e3cc676fdaf673b276c66c8467fc5398c0c6137b","reviewed":true},
      "fr": {"text":"Contenu sain et disponibilité à long terme.","sourceRevision":"9c9fdb147c8a5acdd196ea43e3cc676fdaf673b276c66c8467fc5398c0c6137b","reviewed":true}
    }
