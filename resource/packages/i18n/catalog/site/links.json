  "principles.relevant": {
    "source": "优先技术、开源、社区相关站点。",
    "translations": {
      "en": {"text":"Tech, open-source, and community sites are preferred.","sourceRevision":"ce7590e410dfe657f6b5f680f974245912d46331e2ab92c3d295a25faabb0e24","reviewed":true},
      "ja": {"text":"技術、オープンソース、コミュニティ関連を優先します。","sourceRevision":"ce7590e410dfe657f6b5f680f974245912d46331e2ab92c3d295a25faabb0e24","reviewed":true},
      "it": {"text":"Preferenza per tecnologia, open source e comunità.","sourceRevision":"ce7590e410dfe657f6b5f680f974245912d46331e2ab92c3d295a25faabb0e24","reviewed":true},
      "ru": {"text":"Приоритет — технические, open‑source и сообщественные сайты.","sourceRevision":"ce7590e410dfe657f6b5f680f974245912d46331e2ab92c3d295a25faabb0e24","reviewed":true},
      "ko": {"text":"기술, 오픈 소스 및 커뮤니티 사이트가 선호됩니다.","sourceRevision":"ce7590e410dfe657f6b5f680f974245912d46331e2ab92c3d295a25faabb0e24","reviewed":true},
      "fr": {"text":"Les sites technologiques, de source ouverte et communautaires sont préférés.","sourceRevision":"ce7590e410dfe657f6b5f680f974245912d46331e2ab92c3d295a25faabb0e24","reviewed":true}
    }
  },
