      "ko": {"text":"명확한 사이트 정보 및 안정적인 로고 URL.","sourceRevision":"051bd09fdd72ca6949633c5ef64b4cb0429cf37386c91a38337c35c399f79f49","reviewed":true},
      "fr": {"text":"Effacer les informations du site et une URL de logo stable.","sourceRevision":"051bd09fdd72ca6949633c5ef64b4cb0429cf37386c91a38337c35c399f79f49","reviewed":true}
