{
  "name": "@gooseforum/client",
  "version": "0.1.0",
  "description": "Framework-agnostic client and page payload contracts for GooseForum",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "dev:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leancodebox/GooseForum.git",
    "directory": "resource/packages/client"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
