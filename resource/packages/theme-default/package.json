{
  "name": "@gooseforum/theme-default",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage -c ../../vitest.coverage.config.ts"
  },
  "dependencies": {
    "@gooseforum/client": "workspace:*",
    "@gooseforum/markdown": "workspace:*",
    "@gooseforum/runtime": "workspace:*",
    "@gooseforum/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.13",
    "lucide-react": "^1.45.0",
    "compressorjs": "^1.3.0",
    "cropperjs": "^2.1.1",
    "mermaid": "11.17.1",
    "simple-icons": "^16.20.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.3",
